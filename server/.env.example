# Copie este arquivo para ".env" e ajuste os valores.

# Porta onde a API vai rodar
PORT=3000

# Conexão com o MongoDB. Exemplos:
#   Local:  mongodb://127.0.0.1:27017/colonia-espacial
#   Atlas:  mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/colonia-espacial
MONGODB_URI=mongodb://127.0.0.1:27017/colonia-espacial

# Origens permitidas pelo CORS (endereço do front-end), separadas por vírgula
CORS_ORIGIN=http://localhost:5173
